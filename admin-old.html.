<!doctype html> 
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MEC Admin Dashboard</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#080808;color:#f5f1e8;font-family:Arial,sans-serif}.app{display:flex;min-height:100vh}
aside{position:fixed;inset:0 auto 0 0;width:240px;background:#101010;border-right:1px solid #302819;padding:18px 12px}.brand{padding:10px;border-bottom:1px solid #302819;color:#d9b45d}.logo{width:48px;height:48px;border:1px solid #d9b45d;border-radius:12px;display:grid;place-items:center;font-weight:900}.brand b{display:block;font-size:11px;letter-spacing:1px;margin-top:8px}.brand small{color:#888}
nav{margin-top:18px}nav button{display:block;width:100%;padding:12px;border:0;background:none;color:#aaa;text-align:left;border-radius:8px;margin:3px 0}nav button.active,nav button:hover{background:#211b10;color:#f0cf78}
main{margin-left:240px;width:calc(100% - 240px)}header{height:70px;border-bottom:1px solid #302819;padding:0 26px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:#0a0a0a;z-index:2}.ey{font-size:10px;letter-spacing:3px;color:#d9b45d;font-weight:bold}.admin{color:#f0cf78;font-weight:bold}
.content{padding:26px}.top{display:flex;justify-content:space-between;gap:15px;align-items:end;margin-bottom:20px}h1{font:800 34px Georgia;margin:6px 0}.muted{color:#92908b}.btn{background:linear-gradient(135deg,#f0cf78,#c99e3d);border:0;border-radius:9px;padding:11px 16px;font-weight:800;color:#181208}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card,.panel{background:#131313;border:1px solid #302819;border-radius:14px;padding:18px}.card small{color:#999}.card strong{display:block;font-size:28px;margin:8px 0}.gold{color:#f0cf78}.grid{display:grid;grid-template-columns:1.3fr .7fr;gap:14px;margin-top:14px}.panel h2{font:700 20px Georgia;margin-top:0}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;padding:11px 7px;border-bottom:1px solid #29251e}th{color:#777}.status{color:#f0cf78;background:#211b10;padding:4px 8px;border-radius:15px}.lead{padding:12px 0;border-bottom:1px solid #302819}.lead small{display:block;color:#777;margin-top:4px}.section{display:none}.section.active{display:block}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field label{display:block;color:#aaa;font-size:12px;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;background:#0b0b0b;color:#eee;border:1px solid #393126;border-radius:8px;padding:11px}.field textarea{min-height:100px}.full{grid-column:1/-1}.actions{display:flex;gap:10px;margin-top:16px}
@media(max-width:850px){aside{width:68px;padding:12px 7px}.brand b,.brand small{display:none}.brand{text-align:center}nav button{font-size:0;text-align:center}.main{margin-left:68px;width:calc(100% - 68px)}.cards{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.content{padding:16px}.admin{display:none}}
@media(max-width:560px){.top{flex-direction:column;align-items:flex-start}h1{font-size:28px}.formgrid{grid-template-columns:1fr}.full{grid-column:auto}.panel{overflow:auto}table{min-width:580px}}
</style></head>
<body><div class="app">
<aside><div class="brand"><div class="logo">MEC</div><b>MARGALLA ELITE</b><small>CONSTRUCTION (PVT) LTD</small></div>
<nav>
<button class="active" data-tab="dashboard">▦ Dashboard</button><button data-tab="projects">⌂ Projects</button><button data-tab="leads">♙ Leads / CRM</button><button data-tab="calculator">▧ Calculator Rates</button><button data-tab="gallery">▤ Gallery</button><button data-tab="settings">⚙ Settings</button>
</nav></aside>
<main><header><div><div class="ey">MEC MANAGEMENT SYSTEM</div><b>Admin Dashboard</b></div><div class="admin">Administrator</div></header>

<section id="dashboard" class="section active content"><div class="top"><div><div class="ey">OVERVIEW</div><h1>Good morning, MEC.</h1><p class="muted">Manage projects, leads and calculator settings.</p></div><button class="btn" onclick="show('projects')">＋ Add Project</button></div>
<div class="cards"><div class="card"><small>Active Projects</small><strong>04</strong><span class="gold">2 ongoing</span></div><div class="card"><small>New Leads</small><strong>12</strong><span class="gold">This month</span></div><div class="card"><small>Quote Requests</small><strong>07</strong><span class="gold">Awaiting review</span></div><div class="card"><small>Completed</small><strong>18</strong><span class="gold">Portfolio</span></div></div>
<div class="grid"><div class="panel"><h2>Active Projects</h2><table><tr><th>PROJECT</th><th>LOCATION</th><th>STATUS</th><th>PROGRESS</th></tr><tr><td>House No. 2515<br><span class="muted">1 Kanal</span></td><td>Faisal Town</td><td><span class="status">ONGOING</span></td><td>60%</td></tr><tr><td>MEC Tower 2<br><span class="muted">Commercial</span></td><td>Islamabad</td><td><span class="status">UPCOMING</span></td><td>Soil testing</td></tr><tr><td>House No. 1115<br><span class="muted">5 Marla</span></td><td>Faisal Town</td><td><span class="status">ONGOING</span></td><td>80%</td></tr></table></div>
<div class="panel"><h2>Recent Leads</h2><div class="lead"><b>New Website Lead</b><small>Faisal Hills · 1 Kanal</small></div><div class="lead"><b>Quotation Request</b><small>Faisal Town · 10 Marla</small></div><div class="lead"><b>Construction Inquiry</b><small>B-17 · Complete Construction</small></div></div></div></section>

<section id="projects" class="section content"><div class="top"><div><div class="ey">WEBSITE CONTENT</div><h1>Projects</h1><p class="muted">Add or edit projects without changing HTML.</p></div></div><div class="panel"><div class="formgrid"><div class="field"><label>Project Name</label><input placeholder="House No. 2515"></div><div class="field"><label>Location</label><input placeholder="Faisal Town, Islamabad"></div><div class="field"><label>Plot Size</label><input placeholder="1 Kanal / 10 Marla"></div><div class="field"><label>Status</label><select><option>Ongoing</option><option>Completed</option><option>Upcoming</option></select></div><div class="field"><label>Completion %</label><input type="number" min="0" max="100"></div><div class="field"><label>Bedrooms</label><input type="number"></div><div class="field full"><label>Description</label><textarea placeholder="Project details..."></textarea></div></div><div class="actions"><button class="btn">Save Project</button></div></div></section>

<section id="leads" class="section content"><div class="top"><div><div class="ey">CUSTOMER MANAGEMENT</div><h1>Leads / CRM</h1><p class="muted">Website enquiries and quotation requests.</p></div></div><div class="panel"><table><tr><th>NAME</th><th>PHONE</th><th>LOCATION</th><th>REQUIREMENT</th><th>STATUS</th></tr><tr><td>Website Lead</td><td>03XX-XXXXXXX</td><td>Faisal Hills</td><td>1 Kanal House</td><td><span class="status">NEW</span></td></tr><tr><td>Quotation Request</td><td>03XX-XXXXXXX</td><td>Faisal Town</td><td>Complete Construction</td><td><span class="status">FOLLOW-UP</span></td></tr></table></div></section>

<section id="calculator" class="section content"><div class="top"><div><div class="ey">CALCULATOR CONTROL</div><h1>Calculator Rates</h1><p class="muted">Private rates used to generate estimates; visitors do not see the rates.</p></div></div><div class="panel"><div class="formgrid"><div class="field"><label>Grey Structure / Sq Ft</label><input type="number"></div><div class="field"><label>Finishing / Sq Ft</label><input type="number"></div><div class="field"><label>Complete Construction / Sq Ft</label><input type="number"></div><div class="field"><label>Currency</label><select><option>PKR</option></select></div></div><div class="actions"><button class="btn">Save Rates</button></div></div></section>

<section id="gallery" class="section content"><div class="top"><div><div class="ey">MEDIA</div><h1>Gallery</h1><p class="muted">Upload and organize project photos.</p></div></div><div class="panel"><p class="muted">Production version will include secure image upload, replacement and deletion.</p><button class="btn">＋ Upload Images</button></div></section>

<section id="settings" class="section content"><div class="top"><div><div class="ey">SYSTEM</div><h1>Settings</h1><p class="muted">Company contact details and dashboard access.</p></div></div><div class="panel"><div class="formgrid"><div class="field"><label>WhatsApp Number</label><input placeholder="92XXXXXXXXXX"></div><div class="field"><label>Call Number</label><input placeholder="03XXXXXXXXX"></div><div class="field full"><label>Company Description</label><textarea></textarea></div></div><div class="actions"><button class="btn">Save Settings</button></div></div></section>
</main></div>
<script>
function show(id){document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x.dataset.tab===id));scrollTo(0,0)}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>show(b.dataset.tab));
</script></body></html>
